# ── Supabase (frontend, exposed to mobile app) ───────────────────────────────
# Copy your project URL and anon key from:
#   Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase (Python backend, server-side only) ───────────────────────────────
# Service role key bypasses RLS — keep it server-side only.
# Found in: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── Backend server ────────────────────────────────────────────────────────────
# IP/port of the machine running backend/server.py.
# The ESP32 posts beacon events here; test_with_hand_recognition.py posts
# detection events here.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000

# URL the mobile app uses to reach the backend (must be reachable from the device).
# Use the machine's LAN IP when testing on a physical phone, e.g. http://192.168.0.X:5000
EXPO_PUBLIC_BACKEND_URL=http://127.0.0.1:5000

# Default ESP32 camera stream URL used by the bottle capture tool.
ESP32_STREAM_URL=http://192.168.0.31:81/stream

# YOLO weights used as the base model for fine-tuning captured bottles.
YOLO_WEIGHTS=runs/detect/runs/train_v10/weights/best.pt

# ── ESP32 ─────────────────────────────────────────────────────────────────────
# Set by the backend to know which patient's beacon is being monitored.
# Use the patient_code value from the patients table (e.g. PTK-A1B2).
PATIENT_CODE=PTK-XXXX
